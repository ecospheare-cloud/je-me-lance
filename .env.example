# Resend — https://resend.com
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_FROM_EMAIL=

# Secret pour /api/notify (notification email de nouvel article)
NOTIFY_SECRET=

# Secret pour /api/blog-posts (publication automatique depuis SEO Pilot)
BLOG_PUBLISH_SECRET=

# Token GitHub (scope "repo") utilisé par /api/blog-posts pour committer
# les nouveaux articles dans ce repo et déclencher un redeploy
GITHUB_TOKEN=
GITHUB_REPO=ecospheare-cloud/blog
GITHUB_BRANCH=main
