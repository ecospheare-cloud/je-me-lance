# Le site est exporté en statique pour GitHub Pages.
# Les anciennes API routes Next.js (/api/subscribe, /api/notify, /api/blog-posts)
# sont remplacées par un Cloudflare Worker — voir worker/subscribe.js.

# URL publique du Worker déployé (à définir comme "Variable" dans
# Settings → Secrets and variables → Actions → Variables du repo GitHub,
# pas comme secret puisqu'elle est exposée côté client)
NEXT_PUBLIC_SUBSCRIBE_WORKER_URL=

# --- Variables à configurer sur le Worker Cloudflare (pas ici) ---
# RESEND_API_KEY=
# RESEND_AUDIENCE_ID=
# RESEND_FROM_EMAIL=
# NOTIFY_SECRET=
# BLOG_PUBLISH_SECRET=
# GITHUB_TOKEN=
# GITHUB_REPO=ecospheare-cloud/blog
# GITHUB_BRANCH=claude/gifted-rubin-9aowu6
